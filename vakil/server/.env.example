PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/vakil
JWT_SECRET=replace-with-at-least-32-random-characters
REQUEST_TIMEOUT_SECONDS=60
CORS_ORIGIN=http://localhost:5173
# Optional. If set, admin login must send this value as adminCode.
ADMIN_LOGIN_CODE=
DEV_AUTO_APPROVE_LAWYERS=true
# Optional Firebase service-account JSON on one line. Notifications are still stored when omitted.
FIREBASE_SERVICE_ACCOUNT=
# Offline development: in-process mock database saved to LOCAL_MONGO_FILE.
USE_MONGO_MOCK=false
LOCAL_MONGO_FILE=.local-vakil-db.json
# In-app voice calls (ZEGOCLOUD). The secret stays on the server; apps only get short-lived tokens.
# Length of a normal (paid) chat in minutes; the first chat is a free 1-minute trial.
CHAT_MINUTES=2
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=
# Seconds a call rings before it becomes a missed call.
CALL_RING_SECONDS=30
# Development only. OTP_DEV_MODE prints sign-in codes in the server console and
# returns them to the app until an SMS provider is connected; ALLOW_DEV_LOGIN
# enables the no-OTP /api/auth/login used by test scripts. Both false in production.
OTP_DEV_MODE=false
ALLOW_DEV_LOGIN=false

# Wallet recharge (Razorpay, test mode first). The secret stays on the server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Development only: without Razorpay keys, lets the app add money with a stand-in
# "test recharge" (no real payment). Ignored once the keys above are set.
WALLET_TEST_RECHARGE=false

# Lawyers whose Partner App is closed this long are switched offline (chat and call).
LAWYER_OFFLINE_AFTER_MINUTES=10
